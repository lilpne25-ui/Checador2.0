@page
@model Checador.Web.Pages.ChangePasswordModel
@{
    ViewData["Title"] = "Cambio de password";
}

<div class="auth-shell">
    <div class="row justify-content-center w-100">
        <div class="col-md-8 col-lg-6 col-xl-5">
            <section class="auth-card">
                <header class="panel-header">
                    <p class="hero-kicker mb-1">Seguridad</p>
                    <h1 class="panel-title">Cambio obligatorio de clave</h1>
                    <p class="panel-subtitle">Actualiza tus credenciales para continuar con las vistas de consulta.</p>
                </header>

                <div class="panel-body">
                    @if (!string.IsNullOrWhiteSpace(Model.Message))
                    {
                        <div class="alert @(Model.Success ? "alert-success" : "alert-danger")" role="alert" aria-live="@(Model.Success ? "polite" : "assertive")">@Model.Message</div>
                    }

                    <form method="post" class="row g-3">
                        <div asp-validation-summary="ModelOnly" class="validation-summary-errors" role="alert" aria-live="assertive"></div>
                        <div class="col-12">
                            <label asp-for="Input.CurrentPassword" class="form-label"></label>
                            <input asp-for="Input.CurrentPassword" class="form-control" autocomplete="current-password" />
                            <span asp-validation-for="Input.CurrentPassword" class="text-danger small validation-message"></span>
                        </div>
                        <div class="col-12">
                            <label asp-for="Input.NewPassword" class="form-label"></label>
                            <input asp-for="Input.NewPassword" class="form-control" autocomplete="new-password" />
                            <div class="field-help">Usa una clave robusta y evita repetir la anterior.</div>
                            <span asp-validation-for="Input.NewPassword" class="text-danger small validation-message"></span>
                        </div>
                        <div class="col-12">
                            <button type="submit" class="btn btn-primary w-100">Actualizar clave</button>
                        </div>
                    </form>
                </div>
            </section>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
