@page
@model Checador.Web.Pages.Admin.EmployeeEditModel
@{
    ViewData["Title"] = "Editar empleado";
}

<div class="page-shell">
    <section class="page-hero">
        <div>
            <p class="hero-kicker">Admin / Empleados</p>
            <h1 class="hero-title">Editar empleado #@Model.UserId</h1>
            <p class="hero-description">Actualiza datos base para sincronizacion y reglas de operacion.</p>
        </div>
        <div class="hero-actions">
            <a asp-page="/Admin/Employees" class="btn btn-outline-secondary">Volver</a>
        </div>
    </section>

    @if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
    {
        <div class="alert alert-warning" role="alert" aria-live="assertive">@Model.ErrorMessage</div>
    }

    @if (!string.IsNullOrWhiteSpace(Model.OperationMessage))
    {
        <div class="alert @(Model.OperationSuccess ? "alert-success" : "alert-danger")" role="alert" aria-live="@(Model.OperationSuccess ? "polite" : "assertive")">@Model.OperationMessage</div>
    }

    <form method="post" asp-page-handler="Save" class="panel-form">
        <header class="panel-header">
            <h2 class="panel-title">Datos del empleado</h2>
            <p class="panel-subtitle">Los cambios afectan consultas y procesos administrativos.</p>
        </header>
        <div class="panel-body row g-3">
            <input type="hidden" asp-for="UserId" />

            <div class="col-md-6">
                <label asp-for="Input.EmployeeName" class="form-label"></label>
                <input asp-for="Input.EmployeeName" class="form-control" />
                <span asp-validation-for="Input.EmployeeName" class="text-danger small validation-message"></span>
            </div>

            <div class="col-md-3">
                <label asp-for="Input.Department" class="form-label"></label>
                <input asp-for="Input.Department" class="form-control" />
                <span asp-validation-for="Input.Department" class="text-danger small validation-message"></span>
            </div>

            <div class="col-md-3">
                <label asp-for="Input.Position" class="form-label"></label>
                <input asp-for="Input.Position" class="form-control" />
                <span asp-validation-for="Input.Position" class="text-danger small validation-message"></span>
            </div>

            <div class="col-md-3">
                <label asp-for="Input.PervasiveDept" class="form-label"></label>
                <input asp-for="Input.PervasiveDept" class="form-control" />
                <span asp-validation-for="Input.PervasiveDept" class="text-danger small validation-message"></span>
            </div>

            <div class="col-md-3">
                <label asp-for="Input.PervasiveShift" class="form-label"></label>
                <input asp-for="Input.PervasiveShift" class="form-control" />
                <span asp-validation-for="Input.PervasiveShift" class="text-danger small validation-message"></span>
            </div>

            <div class="col-md-3">
                <label asp-for="Input.WorkScheduleCode" class="form-label"></label>
                <select asp-for="Input.WorkScheduleCode" class="form-select">
                    <option value="">-- Sin horario --</option>
                    @foreach (var schedule in Model.WorkSchedules.OrderBy(x => x.Code))
                    {
                        <option value="@schedule.Code">
                            @schedule.Code - @schedule.Name (@schedule.StartTime.ToString(@"hh\:mm")-@schedule.EndTime.ToString(@"hh\:mm"), tol @schedule.LateToleranceMinutes min)
                        </option>
                    }
                </select>
                <span asp-validation-for="Input.WorkScheduleCode" class="text-danger small validation-message"></span>
            </div>

            <div class="col-md-3 d-flex align-items-end">
                <div class="form-check">
                    <input asp-for="Input.OvertimeAuthorized" class="form-check-input" />
                    <label asp-for="Input.OvertimeAuthorized" class="form-check-label"></label>
                </div>
            </div>
        </div>
        <div class="panel-footer">
            <button type="submit" class="btn btn-primary">Guardar cambios</button>
            <a asp-page="/Admin/Employees" class="btn btn-outline-secondary">Cancelar</a>
        </div>
    </form>

    <form method="post" asp-page-handler="Delete" class="panel-form danger-card">
        <header class="panel-header">
            <h2 class="panel-title">Eliminar empleado</h2>
            <p class="panel-subtitle">Accion irreversible sobre SQL y solicitud de baja en reloj.</p>
        </header>
        <div class="panel-body">
            <input type="hidden" asp-for="UserId" />
            <p class="mb-3">Esta accion elimina al empleado de SQL y solicita eliminacion en reloj.</p>
            <div class="form-check mb-3">
                <input asp-for="DeleteHistoryRows" class="form-check-input" />
                <label asp-for="DeleteHistoryRows" class="form-check-label"></label>
            </div>
            <button type="submit" class="btn btn-danger">Eliminar empleado</button>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
