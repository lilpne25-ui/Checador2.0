@page
@model Checador.Web.Pages.Admin.ManualPunchModel
@{
    ViewData["Title"] = "Alta manual";
}

<div class="page-shell">
    <section class="page-hero">
        <div>
            <p class="hero-kicker">Admin / Asistencia</p>
            <h1 class="hero-title">Alta manual de asistencia</h1>
            <p class="hero-description">Registro puntual o por lote para correcciones controladas de marcas.</p>
        </div>
        <div class="hero-actions">
            <a asp-page="/Admin/Employees" class="btn btn-outline-secondary">Volver a empleados</a>
        </div>
    </section>

    @if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
    {
        <div class="alert alert-warning" role="alert" aria-live="assertive">@Model.ErrorMessage</div>
    }

    @if (!string.IsNullOrWhiteSpace(Model.OperationMessage))
    {
        <div class="alert @(Model.OperationSuccess ? "alert-success" : "alert-danger")" role="alert" aria-live="@(Model.OperationSuccess ? "polite" : "assertive")">@Model.OperationMessage</div>
    }

    <form method="post" class="panel-form">
        <header class="panel-header">
            <h2 class="panel-title">Registrar marca manual</h2>
            <p class="panel-subtitle">Soporta captura unica o carga por lote de un empleado.</p>
        </header>
        <div class="panel-body row g-3">
            <div class="col-md-6">
                <label asp-for="Input.UserId" class="form-label"></label>
                <select asp-for="Input.UserId" class="form-select">
                    <option value="">-- Selecciona empleado --</option>
                    @foreach (var employee in Model.Employees)
                    {
                        <option value="@employee.UserId">#@employee.UserId - @employee.EmployeeName</option>
                    }
                </select>
                <span asp-validation-for="Input.UserId" class="text-danger small validation-message"></span>
            </div>

            <div class="col-md-3">
                <label asp-for="Input.CheckTime" class="form-label"></label>
                <input asp-for="Input.CheckTime" class="form-control" type="datetime-local" />
                <span asp-validation-for="Input.CheckTime" class="text-danger small validation-message"></span>
            </div>

            <div class="col-md-3">
                <label asp-for="Input.InOutMode" class="form-label"></label>
                <select asp-for="Input.InOutMode" class="form-select">
                    <option value="">Auto / sin especificar</option>
                    <option value="0">0 - Entrada</option>
                    <option value="1">1 - Salida</option>
                    <option value="2">2 - Salida comida</option>
                    <option value="3">3 - Entrada comida</option>
                </select>
                <span asp-validation-for="Input.InOutMode" class="text-danger small validation-message"></span>
            </div>

            <div class="col-12">
                <div class="form-check">
                    <input asp-for="Input.UseBatch" class="form-check-input" />
                    <label asp-for="Input.UseBatch" class="form-check-label"></label>
                </div>
            </div>

            <div class="col-12" id="batchBlock">
                <label asp-for="Input.BatchEntriesText" class="form-label"></label>
                <textarea asp-for="Input.BatchEntriesText" class="form-control" rows="6" placeholder="Una marca por linea. Ejemplo:&#10;2026-05-04 08:00|0&#10;2026-05-04 14:05|2&#10;2026-05-04 14:50|3&#10;2026-05-04 18:10|1"></textarea>
                <span asp-validation-for="Input.BatchEntriesText" class="text-danger small validation-message"></span>
                <div class="field-help">Formato: <code>yyyy-MM-dd HH:mm|modo</code>. El modo es opcional (0,1,2,3).</div>
            </div>
        </div>

        <div class="panel-footer">
            <button type="submit" class="btn btn-primary">Registrar marca</button>
            <a asp-page="/Admin/ManualPunch" class="btn btn-outline-secondary">Limpiar</a>
        </div>
    </form>

    @if (Model.LastResult is not null)
    {
        <section class="section-card">
            <header class="section-head">
                <h2 class="section-title">Resultado de insercion</h2>
            </header>
            <div class="section-body">
                <ul class="summary-list">
                    <li><strong>Insertadas:</strong> @Model.LastResult.InsertedPunches</li>
                    <li><strong>Duplicadas:</strong> @Model.LastResult.DuplicatePunches</li>
                    <li><strong>Total empleados dispositivo:</strong> @Model.LastResult.DeviceEmployees</li>
                    <li><strong>Total punches dispositivo:</strong> @Model.LastResult.DevicePunches</li>
                    <li><strong>Ultima sync:</strong> @(Model.LastResult.LastSyncTime?.ToString("yyyy-MM-dd HH:mm") ?? "N/A")</li>
                </ul>
            </div>
        </section>
    }
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        (function () {
            const useBatch = document.getElementById('Input_UseBatch');
            const batchBlock = document.getElementById('batchBlock');
            if (!useBatch || !batchBlock) return;

            const sync = () => {
                batchBlock.style.display = useBatch.checked ? '' : 'none';
            };

            useBatch.addEventListener('change', sync);
            sync();
        })();
    </script>
}

