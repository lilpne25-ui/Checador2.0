@page
@model Checador.Web.Pages.LoginModel
@{
    ViewData["Title"] = "Login";
    Layout = "_Layout";
}

<div class="auth-shell">
    <div class="row justify-content-center w-100">
        <div class="col-md-7 col-lg-5 col-xl-4">
            <section class="auth-card">
                <header class="panel-header">
                    <p class="hero-kicker mb-1">Acceso interno</p>
                    <h1 class="panel-title">Checador Web LAN</h1>
                    <p class="panel-subtitle">Ingreso autorizado para consulta y operacion administrativa.</p>
                </header>
                <div class="panel-body">
                    @if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
                    {
                        <div class="alert alert-danger" role="alert" aria-live="assertive">@Model.ErrorMessage</div>
                    }

                    <form method="post" class="row g-3">
                        <div asp-validation-summary="ModelOnly" class="validation-summary-errors" role="alert" aria-live="assertive"></div>
                        <div class="col-12">
                            <label asp-for="Input.Username" class="form-label"></label>
                            <input asp-for="Input.Username" class="form-control" autocomplete="username" />
                            <div class="field-help">Usuario asignado para la API interna.</div>
                            <span asp-validation-for="Input.Username" class="text-danger small validation-message"></span>
                        </div>
                        <div class="col-12">
                            <label asp-for="Input.Password" class="form-label"></label>
                            <input asp-for="Input.Password" class="form-control" autocomplete="current-password" />
                            <div class="field-help">Respeta mayusculas y minusculas.</div>
                            <span asp-validation-for="Input.Password" class="text-danger small validation-message"></span>
                        </div>
                        <div class="col-12">
                            <button type="submit" class="btn btn-primary w-100">Entrar</button>
                        </div>
                    </form>

                    <div class="field-help mt-3">Si tu cuenta requiere cambio de clave, el sistema te redirige automaticamente.</div>
                </div>
            </section>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
