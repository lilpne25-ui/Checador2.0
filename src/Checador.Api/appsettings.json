{
  "Sql": {
    "ConnectionString": "Server=.;Database=ZKBD;Trusted_Connection=True;TrustServerCertificate=True;Connection Timeout=30;",
    "InitialLookbackDays": 365,
    "AutoSyncMinutes": 15,
    "ForceLookbackWindow": false
  },
  "Device": {
    "Enabled": false,
    "PreferDirect": false,
    "FallbackToAccess": false,
    "EnforceSyncAgentOnly": true,
    "AllowedEntryAssemblies": [ "Checador.SyncAgent" ],
    "Ip": "127.0.0.1",
    "Port": 4370,
    "CommKey": 0,
    "MachineNumber": 1
  },
  "PervasiveSync": {
    "Enabled": false,
    "ConnectionString": "",
    "AttendanceTable": "TIME_ATTENDANCE",
    "InProcessTable": "EMP_IN_PROCESS_G",
    "DeleteInProcessOnExit": true,
    "ProgramName": "OLL302",
    "DefaultShift": "0",
    "DefaultDepartment": "0",
    "CommandTimeoutSeconds": 180,
    "StopSyncOnMirrorFailure": false,
    "SimulationMode": false,
    "OnlyCurrentDayWrites": false,
    "CloseOnlyWithFinalOutMode": false,
    "MinimumOutGapMinutes": 1,
    "MaxRowsPerRun": 200
  },
  "Processing": {
    "StandardWorkDayHours": 8,
    "RoundToMinutes": 5,
    "UseStrictFourPunchPolicy": false,
    "EnableNightShiftSupport": true,
    "NightShiftScheduleCode": 3,
    "NightShiftStartHour": 18,
    "NightShiftRegularEndHour": 7,
    "NightShiftCarryToPreviousDayUntilHour": 12,
    "NightShiftStandardHours": 9.6,
    "Schedule1ExtraCountFromHour": 7,
    "Schedule2ExtraCountFromHour": 8,
    "Schedule3ExtraCountFromHour": 18,
    "Schedule1ExtraMaxHours": 2.4,
    "Schedule2ExtraMaxHours": 2.4,
    "Schedule3ExtraMaxHours": 3.6
  },
  "Report": {
    "OutputDirectory": "reports",
    "TemplatePath": "docs/Formato_Asistencia_Semanal.xlsx",
    "OvertimeTemplatePath": "docs/Formato_HorasExtra_Retardos_ENARMAIN.xlsx",
    "LatenessTemplatePath": "docs/Formato_HorasExtra_Retardos_ENARMAIN.xlsx",
    "DefaultFileNamePattern": "{Empleado}_{Semana}.xlsx",
    "DataStartRow": 2,
    "ForceWriteHeaders": false
  },
  "FeatureFlags": {
    "Modules": {
      "EnablePreview": true,
      "EnableKpi": true,
      "EnableOps": true,
      "EnableOpsTelemetry": true,
      "EnableAdminUsers": true,
      "EnableAdminEmployees": true,
      "EnableAdminPervasive": true,
      "EnableAdminManualPunch": true,
      "EnableAdminSchedules": true,
      "EnableReports": true
    }
  },
  "Cors": {
    "AllowedOrigins": []
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
